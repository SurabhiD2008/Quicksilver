# ─────────────────────────────────────────────────────────────────────────
# Postgres connection (Vercel Postgres / Neon).
#
# On Vercel: add the Postgres integration to your project and these variables
# are injected automatically — you don't need to set anything by hand.
#
# For local dev: copy this file to `.env.local` and paste your pooled
# connection string. @vercel/postgres reads POSTGRES_URL by default.
# ─────────────────────────────────────────────────────────────────────────
POSTGRES_URL="postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
