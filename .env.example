# Copy to .env.local for local development. Every variable is optional: with
# none set, the site runs as a pure front end with analytics switched off.

# Postgres connection string (Neon / Vercel Postgres). On Vercel the Postgres
# integration injects it. Enables the analytics routes.
POSTGRES_URL="postgresql://user:password@host.example.com/dbname?sslmode=require"

# Bearer token for GET /api/stats, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset means the stats route refuses everyone.
STATS_TOKEN=""

# Public address of the site, used for canonical and social links. Defaults to
# the production deployment.
SITE_URL=""
